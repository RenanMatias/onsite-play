<div class="onsite-dialog">
  {{#if (or ammunition modes)}}
  <div class="onsite-save-header">
    {{#if ammunition}}
    <label class="onsite-dc">
      {{localize "ONSITE.Ammo.Label"}}
      <select name="ammunition">{{selectOptions ammunition.choices selected=ammunition.selected}}</select>
    </label>
    {{/if}}
    {{#if modes}}
    <label class="onsite-dc">
      {{localize "ONSITE.Attack.Mode"}}
      <select name="attackMode">{{selectOptions modes.choices selected=modes.selected}}</select>
    </label>
    {{/if}}
  </div>
  {{/if}}
  {{#unless modes}}<input type="hidden" name="attackMode" value="{{defaultMode}}">{{/unless}}
  <p class="onsite-hint">{{localize "ONSITE.Attack.Hint"}}</p>
  <ul class="onsite-targets">
    {{#each targets}}
    <li class="onsite-target">
      <img class="onsite-portrait" src="{{img}}" alt="">
      <div class="onsite-details">
        <span class="onsite-name">{{name}}</span>
        {{#if ../showAC}}<span class="onsite-tag">{{localize "ONSITE.AC"}} {{ac}}</span>{{/if}}
        {{#if totalCover}}<span class="onsite-tag warning">{{localize "ONSITE.Attack.TotalCover"}}</span>{{/if}}
        {{#unless hasHP}}<span class="onsite-tag warning">{{localize "ONSITE.Attack.NoHP"}}</span>{{/unless}}
      </div>
      <div class="onsite-inputs">
        <input type="number" name="{{totalName}}" step="1" placeholder="{{localize 'ONSITE.Attack.Total'}}"
               aria-label="{{localize 'ONSITE.Attack.Total'}}" {{#if first}}autofocus{{/if}}>
        <div class="onsite-radios">
          <label><input type="radio" name="{{natName}}" value="none" checked> {{localize "ONSITE.Attack.Normal"}}</label>
          <label><input type="radio" name="{{natName}}" value="nat20"> {{localize "ONSITE.Attack.Nat20"}}</label>
          <label><input type="radio" name="{{natName}}" value="nat1"> {{localize "ONSITE.Attack.Nat1"}}</label>
        </div>
      </div>
    </li>
    {{/each}}
  </ul>
</div>
