<div class="onsite-dialog">
  <p class="onsite-hint">{{localize "ONSITE.Initiative.Hint"}}</p>
  <ul class="onsite-targets">
    {{#each rows}}
    <li class="onsite-target">
      <img class="onsite-portrait" src="{{img}}" alt="">
      <div class="onsite-details">
        <span class="onsite-name">{{name}}</span>
        <span class="onsite-tag">{{localize "ONSITE.Initiative.Bonus" bonus=bonus}}</span>
      </div>
      <div class="onsite-inputs">
        <input type="number" name="{{totalName}}" step="1" placeholder="{{localize 'ONSITE.Initiative.Total'}}"
               aria-label="{{localize 'ONSITE.Initiative.Total'}}" {{#if first}}autofocus{{/if}}>
      </div>
    </li>
    {{/each}}
  </ul>
</div>
